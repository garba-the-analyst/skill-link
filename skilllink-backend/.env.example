# Copy this file to .env and fill in real values.
# Never commit the real .env — it's already in .gitignore.

# PostgreSQL connection string. Locally this can point at a Docker Postgres
# (see README) or your own instance; in production it's the "Internal
# Database URL" Render gives you when you create a Postgres instance.
DATABASE_URL="postgresql://user:password@localhost:5433/skilllink?schema=public"

# Port the NestJS server listens on. Render sets this automatically in
# production — you only need it locally.
PORT=3000

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# Any second long random string, used to salt volunteer certificate hashes.
CERT_SIGNING_SECRET="replace-with-a-different-long-random-string"

# Optional. Enables POST /ops/seed, an HTTP-triggered way to run the seed
# script on hosts where you can't reach the database or a shell directly
# (e.g. Render's free tier). Leave unset for local dev — you already run
# `npm run db:seed` directly there. See the README's "Deploying to Render"
# section for how to use this.
# SEED_TRIGGER_SECRET="replace-with-a-third-long-random-string"

# Comma-separated list of origins allowed to call this API (your frontend's URL).
CORS_ORIGIN="http://localhost:5173"

# Optional — sets the credentials for the SUPER_ADMIN account created by
# `npm run db:seed`. If you skip these, the seed script prints safe demo
# defaults instead (see README).
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="ChangeThisPassword123!"
